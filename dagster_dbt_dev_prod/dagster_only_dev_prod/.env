# Python version for the project
PYTHON_VERSION="3.11"

# Database connection settings
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="datawarehouse"
POSTGRES_PORT="5434"

# DBT settings for database type and host
HOST_DB="postgres_db_dbt"
TYPE_DB="postgres"
DBT_PROFILES_DIR="/dagster_dbt_project/dbt-project/"

# Dagster settings for port, working directory, and Python path
DAGSTER_PORT="3000"
DAGSTER_WORKDIR="/dagster_dbt_project/dagster_project/"
DAGSTER_HOME="/dagster_dbt_project/dagster_project/"