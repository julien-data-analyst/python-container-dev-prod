# Python version for the project
PYTHON_VERSION="3.11"

# Database connection settings
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="datawarehouse"
POSTGRES_PORT="5434" # Exposes the database on port 5434 to avoid conflicts with local PostgreSQL instances

# DBT settings for database type and host
HOST_DB="postgres_db_dbt"
TYPE_DB="postgres"